{
  "name": "leonard-memento-repo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "leonard-memento-repo",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@leonard-memento/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/claude-code-memento": {
      "resolved": "packages/claude-code",
      "link": true
    },
    "node_modules/opencode-memento": {
      "resolved": "packages/opencode",
      "link": true
    },
    "packages/claude-code": {
      "name": "claude-code-memento",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@leonard-memento/core": "*"
      },
      "bin": {
        "claude-code-memento": "bin/cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@leonard-memento/core",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "memento": "bin/memento.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/opencode": {
      "name": "opencode-memento",
      "version": "1.1.0",
      "license": "MIT",
      "dependencies": {
        "@leonard-memento/core": "*"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
